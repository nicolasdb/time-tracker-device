menu "Filesystem Tool Configuration"

    config FS_TOOL_DEFAULT_MOUNT_POINT
        string "Default mount point"
        default "/littlefs"
        help
            Default filesystem mount point path.

    config FS_TOOL_DEFAULT_PARTITION_LABEL
        string "Default partition label"
        default ""
        help
            Default LittleFS partition label. Leave empty to use the default partition.

    config FS_TOOL_AUTO_FORMAT
        bool "Auto-format on mount failure"
        default y
        help
            Automatically format the filesystem if mounting fails.

    config FS_TOOL_SPACE_CHECK_INTERVAL_MS
        int "Space check interval (milliseconds)"
        default 30000
        range 5000 300000
        help
            How often to check filesystem space usage and publish events.

    config FS_TOOL_LOW_SPACE_THRESHOLD
        int "Low space warning threshold (percent)"
        default 85
        range 50 95
        help
            Filesystem usage percentage at which to publish low space warnings.

    config FS_TOOL_ENABLE_ATOMIC_OPERATIONS
        bool "Enable atomic file operations"
        default y
        help
            Use temporary files and atomic rename for safer file operations.

    config FS_TOOL_ENABLE_HEALTH_CHECK
        bool "Enable filesystem health monitoring"
        default y
        help
            Enable periodic filesystem health checks and test file creation.

    config FS_TOOL_EVENT_TASK_STACK_SIZE
        int "Event task stack size"
        default 3072
        range 2048 8192
        help
            Stack size for the filesystem monitoring task.

endmenu