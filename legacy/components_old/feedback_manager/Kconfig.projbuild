menu "Feedback Manager Configuration"
    config FEEDBACK_LED_GPIO
        int "LED GPIO Number"
        default 7
        help
            GPIO number (IOxx) where WS2812B NeoPixel LED is connected.
            
    config FEEDBACK_LED_BRIGHTNESS
        int "LED Brightness (1-255)"
        default 150
        range 1 255
        help
            Brightness level for the WS2812B LED (1-255).
            Higher values provide better visibility for breathing effects.
            150 is recommended for good visibility while avoiding eye strain.
            
    config FEEDBACK_BREATHING_PERIOD
        int "Breathing Effect Period (cycles)"
        default 40
        range 20 100
        help
            Number of cycles for one complete breathing period.
            Higher values = slower breathing effect.
            
    config FEEDBACK_LOG_LEVEL
        int "Feedback Manager Log Level"
        default 2
        range 0 5
        help
            0=None, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Verbose
endmenu
