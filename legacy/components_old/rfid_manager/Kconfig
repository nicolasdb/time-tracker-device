menu "RFID Configuration"

    choice RFID_MODULE_TYPE
        prompt "RFID Module Type"
        default RFID_MODULE_RC522
        help
            Select the RFID module type to use.

        config RFID_MODULE_RC522
            bool "RC522 (SPI)"
            help
                Use RC522 RFID module with SPI interface.

        config RFID_MODULE_PN532
            bool "PN532 (SPI/I2C)"
            depends on EXPERIMENTAL
            help
                Use PN532 RFID/NFC module with SPI or I2C interface.
                (Not yet implemented)
    endchoice

    config RFID_RST_GPIO
        int "Reset GPIO pin"
        range -1 48
        default 9
        help
            GPIO pin for RFID module reset. Use -1 for soft reset.

    if RFID_MODULE_RC522
        config RFID_RC522_SPI_HOST
            int "SPI Host"
            range 0 2
            default 2
            help
                SPI host to use (SPI2_HOST = 2).

        config RFID_RC522_SPI_MISO
            int "MISO GPIO pin"
            range 0 48
            default 5
            help
                GPIO pin for SPI MISO.

        config RFID_RC522_SPI_MOSI
            int "MOSI GPIO pin"
            range 0 48
            default 6
            help
                GPIO pin for SPI MOSI.

        config RFID_RC522_SPI_SCLK
            int "SCLK GPIO pin"
            range 0 48
            default 4
            help
                GPIO pin for SPI SCLK.

        config RFID_RC522_SPI_CS
            int "CS GPIO pin"
            range 0 48
            default 10
            help
                GPIO pin for SPI CS.
    endif

endmenu