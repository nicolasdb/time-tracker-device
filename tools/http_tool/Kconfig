menu "HTTP Tool Configuration"

    config HTTP_TOOL_WEBHOOK_URL
        string "Webhook Server URL"
        default "http://nicolasdb.eu/webhook"
        help
            HTTP Tool webhook server URL configuration - single source of truth for webhook endpoint.
            
            Examples:
            - Production: http://nicolasdb.eu/webhook
            - Testing: http://httpbin.org/post
            - Local development: http://192.168.1.100:3000/webhook
            
            Note: HTTPS URLs require proper SSL/TLS configuration.

    config HTTP_TOOL_TIMEOUT_MS
        int "HTTP Request Timeout (milliseconds)"
        default 10000
        range 1000 60000
        help
            Timeout for HTTP requests in milliseconds.
            Recommended: 10000ms (10 seconds) for most webhook servers.

    config HTTP_TOOL_MAX_RETRIES
        int "Maximum Retry Attempts"
        default 3
        range 0 10
        help
            Maximum number of retry attempts for failed HTTP requests.
            Set to 0 to disable retries.

    config HTTP_TOOL_RETRY_DELAY_MS
        int "Retry Delay (milliseconds)"
        default 1000
        range 100 10000
        help
            Delay between retry attempts in milliseconds.


endmenu