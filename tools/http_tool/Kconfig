menu "HTTP Tool Configuration"

    config HTTP_TOOL_WEBHOOK_URL
        string "Webhook Server URL"
        default "http://httpbin.org/post"
        help
            The URL of the webhook server where JSON payloads will be sent.
            
            Examples:
            - Testing: http://httpbin.org/post
            - Production: https://your-server.com/api/webhook
            - Local development: http://192.168.1.100:3000/webhook
            
            Note: HTTPS URLs require proper SSL/TLS configuration.

    config HTTP_TOOL_TIMEOUT_MS
        int "HTTP Request Timeout (milliseconds)"
        default 10000
        range 1000 60000
        help
            Timeout for HTTP requests in milliseconds.
            Recommended: 10000ms (10 seconds) for most webhook servers.

    config HTTP_TOOL_MAX_RETRIES
        int "Maximum Retry Attempts"
        default 3
        range 0 10
        help
            Maximum number of retry attempts for failed HTTP requests.
            Set to 0 to disable retries.

    config HTTP_TOOL_RETRY_DELAY_MS
        int "Retry Delay (milliseconds)"
        default 1000
        range 100 10000
        help
            Delay between retry attempts in milliseconds.

    config HTTP_TOOL_TIMEZONE
        string "Device Timezone Configuration"
        default "CET-1CEST,M3.5.0,M10.5.0/3"
        help
            Timezone configuration string for local timestamp conversion.
            Default is set for Belgium/Central European Time (UTC+1) with DST.
            
            Examples:
            - UTC: "UTC0"
            - Central European Time (Belgium): "CET-1CEST,M3.5.0,M10.5.0/3"
            - Pacific Standard Time: "PST8PDT,M3.2.0,M11.1.0"
            - Eastern Standard Time: "EST5EDT,M3.2.0,M11.1.0"
            
            Format: <std><offset><dst>,<start>,<end>
            Where:
            - std: Standard timezone name (3+ chars)
            - offset: Hours offset from UTC (positive = west of UTC)
            - dst: Daylight saving time name (optional)
            - start/end: DST transition rules (optional)

    config HTTP_TOOL_ENABLE_TIMEZONE_AUTO_DETECT
        bool "Enable Automatic Timezone Detection"
        default n
        help
            Automatically detect timezone using IP geolocation API.
            Requires network connectivity and HTTP client support.
            Falls back to manual timezone configuration if detection fails.

endmenu