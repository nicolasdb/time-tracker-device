menu "Webhook Tool Configuration"

    config WEBHOOK_TOOL_DEFAULT_URL
        string "Default webhook URL"
        default "https://api.example.com/webhook"
        help
            Default webhook URL for sending events. Can be overridden at runtime.

    config WEBHOOK_TOOL_MAX_RETRIES
        int "Maximum retry attempts"
        default 3
        range 0 10
        help
            Maximum number of retry attempts for failed webhook requests.

    config WEBHOOK_TOOL_RETRY_DELAY_MS
        int "Retry delay (milliseconds)"
        default 5000
        range 1000 60000
        help
            Delay between retry attempts in milliseconds.

    config WEBHOOK_TOOL_REQUEST_TIMEOUT_MS
        int "Request timeout (milliseconds)"
        default 30000
        range 5000 120000
        help
            HTTP request timeout in milliseconds.

    config WEBHOOK_TOOL_MAX_QUEUE_SIZE
        int "Maximum event queue size"
        default 50
        range 10 200
        help
            Maximum number of events that can be queued for processing.

    config WEBHOOK_TOOL_TASK_STACK_SIZE
        int "Task stack size"
        default 4096
        range 2048 8192
        help
            Stack size for the webhook processing task.

    config WEBHOOK_TOOL_ENABLE_PERSISTENT_QUEUE
        bool "Enable persistent event queue"
        default y
        help
            Save unprocessed events to filesystem for retry after restart.

    config WEBHOOK_TOOL_LOG_RETENTION_HOURS
        int "Log retention period (hours)"
        default 168
        range 24 720
        help
            How long to keep event logs before cleanup (168 hours = 1 week).

endmenu