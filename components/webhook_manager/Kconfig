menu "Webhook Manager Configuration"

config WEBHOOK_MANAGER_URL
    string "Default webhook URL"
    default "http://localhost/webhook"
    help
        The default URL to which webhook events will be sent.

config WEBHOOK_MANAGER_MAX_RETRIES
    int "Default maximum retry attempts"
    default 3
    help
        The number of times the webhook manager will retry sending a failed event.

config WEBHOOK_MANAGER_RETRY_DELAY_MS
    int "Default retry delay (ms)"
    default 5000
    help
        The delay in milliseconds between retry attempts for failed webhook events.

config WEBHOOK_MANAGER_MAX_LOG_ENTRIES
    int "Maximum number of log entries"
    default 50
    help
        The maximum number of webhook events that can be stored in the log.

config WEBHOOK_MANAGER_DEBUG
    bool "Enable debug logs"
    default n
    help
        Enable additional debug logging for webhook operations.

endmenu