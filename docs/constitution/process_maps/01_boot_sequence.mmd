sequenceDiagram
    participant Boot
    participant Main_Task as Main Task
    participant Event_Bus as ESP Event System
    participant FS_Task as FS Task  
    participant Network_Task as Network Task
    participant NTP_Task as NTP Task
    participant RFID_Task as RFID Task
    participant LED_Task as LED Task
    participant System_Task as System Monitor Task
    
    Boot->>Main_Task: FreeRTOS scheduler start
    Main_Task->>Main_Task: Create event loop
    Main_Task->>Event_Bus: esp_event_loop_create_default()
    
    Note over Main_Task: Initialize all tool tasks
    
    Main_Task->>FS_Task: xTaskCreate(fs_task, ...)
    FS_Task->>FS_Task: Mount LittleFS
    FS_Task->>Event_Bus: esp_event_post(FS_EVENT_READY)
    
    Main_Task->>LED_Task: xTaskCreate(led_task, ...)
    LED_Task->>LED_Task: Initialize LED hardware
    LED_Task->>Event_Bus: esp_event_post(LED_EVENT_READY)
    Event_Bus->>LED_Task: FS_EVENT_READY (start cyan flashing)
    
    Main_Task->>Network_Task: xTaskCreate(network_task, ...)
    Network_Task->>Network_Task: Initialize WiFi
    Network_Task->>Event_Bus: esp_event_post(NETWORK_EVENT_READY)
    
    Main_Task->>NTP_Task: xTaskCreate(ntp_task, ...)
    NTP_Task->>Event_Bus: esp_event_handler_register(NETWORK_EVENT_CONNECTED)
    NTP_Task->>Event_Bus: esp_event_post(NTP_EVENT_READY)
    
    Main_Task->>RFID_Task: xTaskCreate(rfid_task, ...)
    RFID_Task->>RFID_Task: Initialize RC522 SPI
    RFID_Task->>Event_Bus: esp_event_post(RFID_EVENT_READY)
    
    Main_Task->>System_Task: xTaskCreate(system_monitor_task, ...)
    System_Task->>Event_Bus: esp_event_handler_register(RFID_EVENT_TAG_DETECTED)
    System_Task->>Event_Bus: esp_event_post(SYSTEM_EVENT_READY)
    
    Note over Event_Bus: All tasks ready - start grace period
    
    Main_Task->>Event_Bus: esp_event_post(SYSTEM_EVENT_GRACE_PERIOD_START)
    Event_Bus->>LED_Task: GRACE_PERIOD_START
    LED_Task->>LED_Task: Cyan breathing (5 seconds)
    Event_Bus->>RFID_Task: GRACE_PERIOD_START
    RFID_Task->>RFID_Task: Read tags but ignore events
    
    Note over Main_Task: 5 second grace period
    
    Main_Task->>Event_Bus: esp_event_post(SYSTEM_EVENT_GRACE_PERIOD_END)
    Event_Bus->>RFID_Task: GRACE_PERIOD_END
    RFID_Task->>RFID_Task: Enable event generation
    Event_Bus->>LED_Task: GRACE_PERIOD_END  
    LED_Task->>LED_Task: Blue breathing (ready state)
    
    Note over System_Task: System fully operational
    Note over RFID_Task: Scanning for tag events
    Note over LED_Task: Ready for state changes