sequenceDiagram
    participant RFID as rfid_tool
    participant Main as main.c
    participant HTTP as http_tool
    participant FS as fs_tool
    participant Net as network_tool
    participant LED as feedback_tool
    participant Debug as debug_tool
    
    Note over Main: System running normally
    
    RFID->>Main: 🔔 New event ready
    Main->>HTTP: http_send_payload(&payload)
    HTTP->>HTTP: POST to webhook URL
    
    Note over HTTP: Network timeout after 5 seconds
    HTTP->>Main: ❌ http_error_timeout (attempt 1)
    HTTP->>HTTP: Schedule retry: 1 second
    HTTP->>Main: 🔄 http_retrying
    
    Main->>LED: feedback_show_state(RETRY)
    LED->>LED: YELLOW flash (warning - retrying)
    
    Main->>Debug: debug_update_dashboard()
    Debug->>Debug: Update robot face: (•ᴗ•)っ
    Debug->>Debug: Show "HTTP Retry 1/8"
    
    Note over HTTP: Wait 1 second...
    
    HTTP->>HTTP: Retry POST request
    HTTP->>Main: ❌ http_error_timeout (attempt 2)
    HTTP->>HTTP: Schedule retry: 2 seconds
    
    Main->>Debug: debug_update_dashboard()
    Debug->>Debug: Show "HTTP Retry 2/8"
    
    Note over HTTP: Wait 2 seconds...
    
    HTTP->>HTTP: Retry POST request  
    HTTP->>Main: ❌ http_error_timeout (attempt 3)
    HTTP->>HTTP: Schedule retry: 4 seconds
    
    Main->>LED: feedback_show_state(ERROR)
    LED->>LED: Red slow blink
    
    Main->>Debug: debug_update_dashboard()
    Debug->>Debug: Update robot face: (ಠ_ಠ)っ
    Debug->>Debug: Show "HTTP Retry 3/8 - DEGRADED"
    
    alt WiFi Connection Lost
        Net->>Main: ❌ net_error_disconnected
        Main->>HTTP: Stop retries - no network
        HTTP->>Main: 🟡 http_waiting_network
        
        Main->>LED: feedback_show_state(OFFLINE)
        LED->>LED: BLUE breathing with GREEN tints
        
        Main->>Debug: debug_update_dashboard()
        Debug->>Debug: Show "OFFLINE MODE"
        Debug->>Debug: Show WiFi: ❌ Disconnected
        Debug->>Debug: Show pending sync queue status
        
        loop WiFi Reconnection Attempts
            Net->>Net: Try to reconnect
            Net->>Main: 🔄 net_connecting
            
            alt WiFi Restored
                Net->>Main: ✅ net_connected
                
                Note over HTTP: Reset backoff - connection restored
                HTTP->>HTTP: Reset retry_context.attempt = 0
                HTTP->>Main: 🔄 http_sending (immediate retry)
                
                HTTP->>HTTP: POST request with fresh connection
                HTTP->>Main: ✅ http_idle (success!)
                
                Main->>FS: fs_delete_payload(payload_id)
                Main->>LED: feedback_show_state(SYNCED)
                LED->>LED: Green flash + blue pulse
                
                Main->>Debug: debug_update_dashboard()
                Debug->>Debug: Update robot face: (◕‿◕)っ
                Debug->>Debug: Show "ONLINE - Synced"
                
            else WiFi Still Failed
                Net->>Main: ❌ net_error_no_connection
                Note over Main: Continue offline storage
            end
        end
        
    else Max Retries Reached (8 attempts)
        HTTP->>Main: ❌ http_error_max_retries
        HTTP->>Main: 🔴 http_idle (gave up)
        
        Main->>FS: fs_mark_payload_failed(payload_id)
        
        Main->>LED: feedback_show_state(CRITICAL_ERROR)
        LED->>LED: Fast red blink pattern
        
        Main->>Debug: debug_update_dashboard()
        Debug->>Debug: Update robot face: (╯°□°)╯
        Debug->>Debug: Show "HTTP FAILED - Manual check needed"
        
        Note over Main: Payload marked failed but kept for manual review
    end
    
    Note over Main: Error handling complete
    Note over Main: System ready for next event
