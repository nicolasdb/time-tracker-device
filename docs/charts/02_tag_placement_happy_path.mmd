sequenceDiagram
    participant User
    participant RFID as rfid_tool
    participant Main as main.c
    participant Payload as payload_tool
    participant FS as fs_tool
    participant HTTP as http_tool
    participant LED as feedback_tool
    participant Debug as debug_tool
    
    Note over User: Places NFC tag on device
    
    User->>RFID: Tag detected by RC522
    RFID->>RFID: Read tag UID: "3A:FD:90:2E"
    
    alt Tag different from last scan OR > 5 seconds since last
        RFID->>RFID: Create rfid_event_t in memory
        Note over RFID: {<br/>  tag_uid: "3A:FD:90:2E",<br/>  internal_millis: 123456,<br/>  type: TAG_PLACED,<br/>  processed: false<br/>}
        
        RFID->>Main: 🔔 New event in buffer
        RFID->>Main: 🟢 rfid_scanning (event ready)
        
        Main->>Payload: payload_format_event(&event)
        Payload->>Payload: Calculate real timestamp using NTP
        Payload->>Payload: Add device metadata
        Note over Payload: {<br/>  device_id: "ESP32_F0F5BD",<br/>  tag_uid: "3A:FD:90:2E",<br/>  event_type: "tag_placed",<br/>  timestamp: "2025-01-15T10:30:45Z",<br/>  internal_millis: 123456,<br/>  ntp_offset_ms: 1642234245000<br/>}
        Payload->>Main: ✅ Formatted payload ready
        
        Main->>FS: fs_write_payload(&payload)
        FS->>FS: Save to LittleFS
        FS->>Main: ✅ fs_idle (saved)
        
        Main->>LED: feedback_show_state(SESSION_STARTED)
        LED->>LED: Green flash pattern
        LED->>Main: ✅ feedback_animating
        
        alt WiFi Connected
            Main->>HTTP: http_send_payload(&payload)
            HTTP->>HTTP: POST to webhook URL
            HTTP->>Main: 🔄 http_sending
            
            alt HTTP Success
                HTTP->>Main: ✅ http_idle (sent)
                Main->>LED: feedback_show_state(SYNCED)
                LED->>LED: Quick blue pulse
                Main->>FS: fs_delete_payload(payload_id)
            else HTTP Failed
                HTTP->>Main: ❌ http_error_network
                HTTP->>HTTP: Schedule retry with backoff
                Note over HTTP: Will retry in 1s, 2s, 4s...
                Main->>LED: feedback_show_state(OFFLINE)
                LED->>LED: Orange pulse pattern
            end
        else No WiFi
            Note over Main: Payload stored for later sync
            Main->>LED: feedback_show_state(OFFLINE)
            LED->>LED: BLUE breathing with GREEN tints
        end
        end
        
        Main->>Debug: debug_update_dashboard()
        Debug->>Debug: Update robot face: (◕‿◕)っ
        Debug->>Debug: Show event count, sync status
        
    else Duplicate tag within 5 seconds
        RFID->>RFID: Ignore duplicate scan
        RFID->>Main: 🟡 rfid_scanning (ignored)
        Main->>LED: feedback_show_state(IGNORED)
        LED->>LED: Quick yellow flash
        
        Main->>Debug: debug_update_dashboard()
        Debug->>Debug: Show ignored event in dashboard
    end
    
    Note over User: Tag placement complete
    Note over Main: System ready for next event
