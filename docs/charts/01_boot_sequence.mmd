sequenceDiagram
    participant Main as main.c
    participant FS as fs_tool
    participant Net as network_tool
    participant NTP as ntp_tool
    participant RFID as rfid_tool
    participant Debug as debug_tool
    participant HTTP as http_tool
    participant LED as feedback_tool
    
    Note over Main: System Boot Started
    
    Main->>FS: fs_tool_init()
    FS->>FS: Initialize LittleFS
    FS->>Main: ✅ fs_idle
    
    Main->>Debug: debug_tool_init()
    Debug->>Debug: Setup ASCII dashboard
    Debug->>Main: ✅ debug_idle
    
    Main->>LED: feedback_tool_init()
    LED->>LED: Initialize WS2812
    LED->>LED: Show CYAN fast flash (initialization)
    LED->>Main: ✅ feedback_idle
    
    Main->>Net: network_tool_init()
    Net->>FS: fs_read_config(wifi_config)
    FS->>Net: wifi credentials
    
    alt WiFi credentials exist
        Net->>Net: Connect to stored WiFi
        Note over Net: Trying stored networks...
        Net->>Main: 🔄 net_connecting
        Net->>Main: ✅ net_connected
        LED->>LED: Show WiFi success (green flash)
    else No WiFi or connection failed
        Net->>Net: Start AP mode
        Net->>Net: Start config webserver
        Net->>Main: 🟡 net_ap_mode
        LED->>LED: Show AP mode (purple breathing)
    end
    
    alt WiFi Connected
        Main->>NTP: ntp_tool_init()
        NTP->>NTP: Sync with time server
        NTP->>Main: 🔄 ntp_syncing
        NTP->>Main: ✅ ntp_synced
        LED->>LED: Show time sync (blue flash)
    else No WiFi
        Note over Main: Skip NTP, use internal clock
    end
    
    Main->>RFID: rfid_tool_init()
    RFID->>RFID: Initialize RC522 module
    RFID->>Main: ✅ rfid_idle (grace period)
    
    Note over Main: Boot Grace Period (5 seconds)
    Note over RFID: RFID scanning disabled during grace period
    Note over LED: CYAN breathing - "Please wait, system starting"
    LED->>LED: CYAN breathing pattern
    
    Main->>Main: Wait CONFIG_BOOT_GRACE_PERIOD (5s)
    
    alt Tag present during grace period
        RFID->>RFID: Detect existing tag (don't trigger event)
        Note over RFID: Flag: initial_tag_present = true
        LED->>LED: Continue CYAN breathing
    else No tag during grace period
        Note over RFID: Normal startup, ready to scan
    end
    
    Note over Main: Grace period complete
    Main->>RFID: Enable tag scanning
    RFID->>RFID: Start scanning task
    RFID->>Main: ✅ rfid_scanning
    
    Main->>HTTP: http_tool_init()
    HTTP->>HTTP: Prepare HTTP client
    HTTP->>Main: ✅ http_idle
    
    Main->>Debug: debug_update_dashboard()
    Debug->>Debug: Render system status
    Debug->>Debug: Print ASCII dashboard
    
    Note over Main: Boot Complete - System Ready
    
    alt Initial tag was present during grace period
        Main->>RFID: Process existing tag as new session
        RFID->>Main: 🔔 Fresh session start
        LED->>LED: GREEN flash → GREEN solid (session confirmed)
    else No initial tag
        LED->>LED: BLUE breathing (idle state - ready)
    end
    
    loop Every 100ms
        Main->>Main: Poll tool states
        Main->>Debug: Update dashboard if needed
    end
