stateDiagram-v2
    [*] --> Booting
    
    Booting --> Initializing : Start tool initialization
    Initializing --> GracePeriod : All tools ready
    
    GracePeriod --> WiFiSetup : No WiFi credentials
    GracePeriod --> ConnectingWiFi : Has WiFi credentials
    
    WiFiSetup --> APMode : Create setup network
    APMode --> ProcessingConfig : User submits WiFi config
    ProcessingConfig --> ConnectingWiFi : Credentials saved
    
    ConnectingWiFi --> TimeSync : WiFi connected
    ConnectingWiFi --> OfflineMode : WiFi failed after retries
    
    TimeSync --> Ready : NTP sync successful
    TimeSync --> ReadyNoTime : NTP sync failed
    
    Ready --> Tracking : RFID event detected
    Ready --> OfflineMode : WiFi lost
    Ready --> APMode : Manual reset requested
    
    ReadyNoTime --> Tracking : RFID event detected (no time sync)
    ReadyNoTime --> TimeSync : WiFi restored
    ReadyNoTime --> OfflineMode : WiFi lost
    
    Tracking --> Ready : Event processed successfully
    Tracking --> TrackingOffline : WiFi lost during processing
    Tracking --> ErrorState : Critical error during processing
    
    OfflineMode --> ConnectingWiFi : WiFi restored
    OfflineMode --> TrackingOffline : RFID event while offline
    OfflineMode --> APMode : Manual reset requested
    
    TrackingOffline --> OfflineMode : Event stored locally
    TrackingOffline --> SyncingData : WiFi restored
    
    SyncingData --> Ready : All data synced successfully
    SyncingData --> OfflineMode : Sync failed
    SyncingData --> TrackingOffline : New RFID event during sync
    
    ErrorState --> Ready : Error resolved
    ErrorState --> OfflineMode : Degraded operation
    ErrorState --> Booting : System reset required
    
    state Ready {
        [*] --> Scanning
        Scanning --> Debouncing : Tag detected
        Debouncing --> Processing : Valid new event
        Debouncing --> Scanning : Duplicate/too recent
        Processing --> Formatting : Create payload
        Formatting --> Storing : Save to FS
        Storing --> Sending : Queue for HTTP
        Sending --> FlowAwareness : Session active 60+ min
        Sending --> Scanning : Success (< 60 min)
        Sending --> Retrying : HTTP failed
        Retrying --> Sending : Retry attempt
        Retrying --> Scanning : Max retries or success
        FlowAwareness --> Scanning : Session ended
        FlowAwareness --> FlowUrgency : 90+ minutes
        FlowUrgency --> Scanning : Session ended
    }
    
    state FlowAwareness {
        [*] --> OrangeBreathing
        OrangeBreathing --> OrangeBreathing : Continue gentle awareness
    }
    
    state FlowUrgency {
        [*] --> OrangePulsing  
        OrangePulsing --> OrangePulsing : Continue transition invitation
    }
    
    state Initializing {
        [*] --> ToolsStarting
        ToolsStarting --> ToolsReady : All tools initialized
        ToolsReady --> [*] : Ready for grace period
    }
    
    state GracePeriod {
        [*] --> WaitingGrace
        WaitingGrace --> TagDetectedDuringGrace : Tag present
        WaitingGrace --> GraceComplete : 5 seconds elapsed
        TagDetectedDuringGrace --> GraceComplete : Grace period ends
        GraceComplete --> [*] : Enable RFID scanning
    }
    
    state OfflineMode {
        [*] --> OfflineScanning
        OfflineScanning --> OfflineProcessing : Tag detected
        OfflineProcessing --> OfflineStoring : Store locally
        OfflineStoring --> OfflineScanning : Event saved
    }
    
    state APMode {
        [*] --> ServingPortal
        ServingPortal --> WaitingConfig : Portal accessible
        WaitingConfig --> ValidatingConfig : Config received
        ValidatingConfig --> WaitingConfig : Invalid config
        ValidatingConfig --> [*] : Valid config saved
    }
    
    state SyncingData {
        [*] --> LoadingQueue
        LoadingQueue --> SendingQueued : Load stored events
        SendingQueued --> SendingQueued : Retry failed events
        SendingQueued --> CleaningUp : All events sent
        CleaningUp --> [*] : Queue cleared
    }
