{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Time Tracker Device Payload Schema",
  "description": "JSON schema for ESP32 time tracker device payloads sent to webhook server",
  "type": "object",
  "properties": {
    "rfid_poll_result": {
      "type": "object",
      "description": "RFID polling result data for server integration",
      "properties": {
        "event_type": {
          "type": "string",
          "enum": ["tag_placed", "tag_removed"],
          "description": "Type of RFID event"
        },
        "tag_id": {
          "type": "string",
          "pattern": "^[0-9A-F]{12}$",
          "description": "RFID tag unique identifier (12 hex characters)"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9A-F]{12}$",
          "description": "Device unique identifier based on MAC address"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of the event"
        },
        "tag_present": {
          "type": "boolean",
          "description": "Whether the tag is currently present"
        },
        "ntp_synced": {
          "type": "boolean",
          "description": "Whether the timestamp is NTP-synchronized"
        },
        "session_id": {
          "type": "string",
          "description": "Session identifier for event pairing"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0,
          "description": "Event sequence number for ordering"
        },
        "wifi_rssi": {
          "type": "integer",
          "minimum": -100,
          "maximum": 0,
          "description": "WiFi signal strength in dBm"
        },
        "wifi_status": {
          "type": "string",
          "enum": ["excellent", "good", "fair", "poor", "disconnected"],
          "description": "WiFi connection quality assessment"
        },
        "free_memory_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Available device memory in bytes"
        },
        "firmware_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Device firmware version (semantic versioning)"
        },
        "uptime_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Device uptime in milliseconds"
        },
        "event_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Confidence level of the event (0.0-1.0)"
        },
        "processing_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Event processing time in milliseconds"
        }
      },
      "required": ["event_type", "tag_id", "device_id", "timestamp", "tag_present"],
      "additionalProperties": false
    }
  },
  "required": ["rfid_poll_result"],
  "additionalProperties": false,
  "examples": [
    {
      "rfid_poll_result": {
        "event_type": "tag_placed",
        "tag_id": "048945AF790000",
        "device_id": "70041D93DDCC",
        "timestamp": "2025-07-08T12:01:39",
        "tag_present": true,
        "ntp_synced": true,
        "session_id": "sess_1720442499_048945AF790000",
        "sequence_number": 1720442499,
        "wifi_rssi": -45,
        "wifi_status": "good",
        "free_memory_bytes": 148236,
        "firmware_version": "6.1.0",
        "uptime_ms": 2509234,
        "event_confidence": 0.95,
        "processing_time_ms": 10
      }
    },
    {
      "rfid_poll_result": {
        "event_type": "tag_removed",
        "tag_id": "048945AF790000",
        "device_id": "70041D93DDCC",
        "timestamp": "2025-07-08T12:05:42",
        "tag_present": false
      }
    }
  ]
}